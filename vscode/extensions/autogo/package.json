{
  "name": "autogo",
  "displayName": "AutoGo Script Engine Console",
  "description": "AutoGo AG、ADB、远程 GLua 引擎、DAP 调试与完整 GLua 语言支持。",
  "version": "1.0.0",
  "publisher": "Zing",
  "author": "zing",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZingYao/autogo_scriptengine_debugger.git",
    "directory": "vscode/extensions/autogo"
  },
  "bugs": {
    "url": "https://github.com/ZingYao/autogo_scriptengine_debugger/issues"
  },
  "homepage": "https://zingyao.github.io/autogo_scriptengine/",
  "license": "MIT",
  "keywords": [
    "lua",
    "glua",
    "language-server",
    "debug-adapter"
  ],
  "scripts": {
    "sync:icons": "../../../scripts/sync-editor-icons.sh",
    "build": "npm run sync:icons && npm run build:tools && esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "build:tools": "../../../scripts/build-glua-tools-platforms.sh",
    "build:gluals": "npm run build:tools",
    "build:extension": "esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js && esbuild server/index.js --bundle --platform=node --format=cjs --outfile=dist/server.js",
    "vscode:prepublish": "npm run build",
    "test": "node test/extension.test.js && node test/request-json.test.js && node test/dap-path-proxy.test.js && node test/gluals-resolver.test.js && node test/syntax-highlighting.test.js && node test/builtin-stub.test.js && node test/golden-diagnostics.test.js && node test/golden-require-definition.test.js && node test/golden-completion.test.js && node test/formatting.test.js && node test/debug-attach.test.js"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:glua",
    "onLanguage:lua",
    "onLanguage:javascript",
    "workspaceContains:**/*.glua",
    "workspaceContains:**/*.lua",
    "workspaceContains:**/*.js",
    "onCommand:glua.openBuiltinSignatureJson",
    "onCommand:glua.showBuiltinDocStatus",
    "onCommand:glua.startAttachDebug",
    "onCommand:glua.runCurrentFile",
    "onCommand:glua.debugCurrentFile",
    "onCommand:glua.selectGluaExecutable",
    "onCommand:glua.selectGluacExecutable",
    "onCommand:glua.selectBuiltinDocs",
    "onDebugResolve:glua",
    "onCommand:autogo.quickDebug",
    "onCommand:autogo.run",
    "onCommand:autogo.stop",
    "onCommand:autogo.remoteEngine",
    "onCommand:autogo.startEngine",
    "onCommand:autogo.restartEngine",
    "onCommand:autogo.syncResources",
    "onCommand:autogo.nodeAssistant",
    "onCommand:autogo.buildArm64",
    "onCommand:autogo.buildX8664",
    "onCommand:autogo.buildX86",
    "onCommand:autogo.buildApk",
    "onCommand:autogo.remoteRunCurrent",
    "onCommand:autogo.compileGluac",
    "onCommand:autogo.compileRunGluac",
    "onCommand:autogo.compileDebugGluac",
    "onCommand:autogo.initAndroid",
    "onCommand:autogo.initIos",
    "onCommand:autogo.refreshDevices",
    "onCommand:autogo.pushFile",
    "onCommand:autogo.officialDocs",
    "onCommand:autogo.openSettings",
    "onCommand:autogo.applyEngineConfig",
    "onCommand:autogo.checkUpdate",
    "onCommand:autogo.discoverTools",
    "onCommand:autogo.testProxy",
    "onCommand:autogo.setRemoteToken",
    "onCommand:autogo.showConsole",
    "onView:autogo.console",
    "onCommand:autogo.selectModules",
    "onCommand:autogo.switchToWireless",
    "onCommand:autogo.pairWireless",
    "onCommand:autogo.setProxyPassword",
    "onCommand:autogo.selectAgPath",
    "onCommand:autogo.selectAdbPath",
    "onCommand:autogo.selectGoPath",
    "onCommand:autogo.selectGluacPath",
    "onCommand:autogo.selectCustomInitializer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "glua.openBuiltinSignatureJson",
        "title": "%glua.openBuiltinSignatureJson.title%"
      },
      {
        "command": "glua.showBuiltinDocStatus",
        "title": "%glua.showBuiltinDocStatus.title%"
      },
      {
        "command": "glua.showOutput",
        "title": "%glua.showOutput.title%"
      },
      {
        "command": "glua.createAttachConfig",
        "title": "%glua.createAttachConfig.title%"
      },
      {
        "command": "glua.startAttachDebug",
        "title": "%glua.startAttachDebug.title%"
      },
      {
        "command": "glua.runCurrentFile",
        "title": "%glua.runCurrentFile.title%"
      },
      {
        "command": "glua.debugCurrentFile",
        "title": "%glua.debugCurrentFile.title%"
      },
      {
        "command": "glua.selectGluaExecutable",
        "title": "%glua.selectGluaExecutable.title%"
      },
      {
        "command": "glua.selectGluacExecutable",
        "title": "%glua.selectGluacExecutable.title%"
      },
      {
        "command": "glua.selectBuiltinDocs",
        "title": "%glua.selectBuiltinDocs.title%"
