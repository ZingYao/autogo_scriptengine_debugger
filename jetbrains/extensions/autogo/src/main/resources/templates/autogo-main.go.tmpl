// detailedLuaError 保留 Lua 原始错误对象与失败现场调用栈，避免只上报分类错误 lua error。
func detailedLuaError(err error) string {
	if err == nil { return "" }
	message := err.Error()
	object := gruntime.ErrorObject(err)
	if object.Kind == gruntime.KindString {
		message = object.String
	} else if converted, convertErr := gruntime.ToString(object); convertErr == nil && converted.Kind == gruntime.KindString {
		message = converted.String
	}
	var runtimeErr *gruntime.RuntimeError
	if errors.As(err, &runtimeErr) && runtimeErr != nil && len(runtimeErr.TracebackFrames) > 0 {
		return gruntime.Traceback(message, runtimeErr.TracebackFrames)
	}
	return message
}

// firstErrorLine 返回适合状态栏展示的错误摘要，完整错误仍写入 Lua 输出区。
func firstErrorLine(detail string) string { if index := strings.IndexByte(detail, '\n'); index >= 0 { return detail[:index] }; return detail }

// executeScriptFile 为当前脚本目录补充 GLua require 搜索规则，并通过真实文件入口保持 DAP 源码映射。
func executeScriptFile(engine *lua_engine.LuaEngine, entry string) error {
	scriptWorkingDirectoryMu.Lock()
	defer scriptWorkingDirectoryMu.Unlock()
	absoluteEntry, err := filepath.Abs(entry)
	if err != nil { return fmt.Errorf("resolve script entry: %w", err) }
	previousDirectory, err := os.Getwd()
	if err != nil { return fmt.Errorf("read process working directory: %w", err) }
	directoryPath := filepath.Dir(absoluteEntry)
	if err := os.Chdir(directoryPath); err != nil { return fmt.Errorf("enter script directory %q: %w", directoryPath, err) }
	directory := filepath.ToSlash(directoryPath)
	patterns := directory + "/?.glua;" + directory + "/?/init.glua;" + directory + "/?.lua;" + directory + "/?/init.lua"
	bootstrap := fmt.Sprintf("package.path = %s .. ';' .. package.path\nreturn dofile(%s)", strconv.Quote(patterns), strconv.Quote(filepath.ToSlash(absoluteEntry)))
	runErr := engine.ExecuteString(bootstrap, directoryPath)
	restoreErr := os.Chdir(previousDirectory)
	if runErr != nil { if restoreErr != nil { return fmt.Errorf("%w; restore working directory: %v", runErr, restoreErr) }; return runErr }
	if restoreErr != nil { return fmt.Errorf("restore working directory: %w", restoreErr) }
	return nil
}

