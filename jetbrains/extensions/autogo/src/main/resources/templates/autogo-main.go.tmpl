func (c *controller) diff(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost { methodNotAllowed(w); return }
	var request diffRequest
	if err := decodeJSON(r, &request); err != nil { writeError(w, http.StatusBadRequest, "INVALID_MANIFEST", err); return }
	if err := validID(request.ManifestID); err != nil { writeError(w, http.StatusBadRequest, "INVALID_MANIFEST", err); return }
	missing := make([]string, 0)
	c.mu.Lock(); currentManifest := c.manifestID; c.mu.Unlock()
	stagingRoot := filepath.Join(c.remoteRoot, "staging", request.ManifestID)
	releaseRoot := filepath.Join(c.remoteRoot, "releases", request.ManifestID)
	_, releaseStatErr := os.Stat(releaseRoot)
	releaseExists := releaseStatErr == nil
	_ = os.RemoveAll(stagingRoot)
	if err := os.MkdirAll(stagingRoot, 0700); err != nil { writeError(w, http.StatusInternalServerError, "STAGING_FAILED", err); return }
	for _, item := range request.Files {
		path, err := safeJoin(filepath.Join(c.remoteRoot, "releases", request.ManifestID), item.Path)
		if err != nil { writeError(w, http.StatusBadRequest, "INVALID_PATH", err); return }
		hash, hashErr := fileSHA256(path)
		if hashErr == nil && strings.EqualFold(hash, item.SHA256) {
			target, targetErr := safeJoin(stagingRoot, item.Path)
			if targetErr == nil { targetErr = copyRegularFile(path, target) }
			if targetErr != nil { writeError(w, http.StatusInternalServerError, "STAGING_FAILED", targetErr); return }
			continue
		}
		if currentManifest != "" && currentManifest != request.ManifestID {
			currentPath, currentErr := safeJoin(filepath.Join(c.remoteRoot, "releases", currentManifest), item.Path)
			currentHash, currentHashErr := fileSHA256(currentPath)
			if currentErr == nil && currentHashErr == nil && strings.EqualFold(currentHash, item.SHA256) {
				target, targetErr := safeJoin(stagingRoot, item.Path)
				if targetErr == nil { targetErr = copyRegularFile(currentPath, target) }
				if targetErr != nil { writeError(w, http.StatusInternalServerError, "STAGING_FAILED", targetErr); return }
				continue
			}
		}
		missing = append(missing, item.Path)
	}
	if releaseExists && len(missing) == 0 { _ = os.RemoveAll(stagingRoot) }
	writeJSON(w, http.StatusOK, map[string]any{"manifestId": request.ManifestID, "upload": missing})
}

func (c *controller) upload(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost { methodNotAllowed(w); return }
	r.Body = http.MaxBytesReader(w, r.Body, maxFileBytes*2)
	var request uploadRequest
	if err := decodeJSON(r, &request); err != nil { writeError(w, http.StatusBadRequest, "INVALID_UPLOAD", err); return }
	if err := validID(request.ManifestID); err != nil { writeError(w, http.StatusBadRequest, "INVALID_MANIFEST", err); return }
	content, err := base64.StdEncoding.DecodeString(request.Content)
	if err != nil || int64(len(content)) > maxFileBytes { writeError(w, http.StatusBadRequest, "INVALID_CONTENT", errors.New("文件内容或大小无效")); return }
	hash := sha256.Sum256(content)
	if !strings.EqualFold(hex.EncodeToString(hash[:]), request.SHA256) { writeError(w, http.StatusBadRequest, "HASH_MISMATCH", errors.New("上传内容哈希不匹配")); return }
	target, err := safeJoin(filepath.Join(c.remoteRoot, "staging", request.ManifestID), request.Path)
	if err != nil { writeError(w, http.StatusBadRequest, "INVALID_PATH", err); return }
	if err = os.MkdirAll(filepath.Dir(target), 0700); err == nil { err = os.WriteFile(target, content, 0600) }
	if err != nil { writeError(w, http.StatusInternalServerError, "UPLOAD_FAILED", err); return }
	writeJSON(w, http.StatusOK, map[string]any{"path": request.Path, "sha256": request.SHA256})
}

