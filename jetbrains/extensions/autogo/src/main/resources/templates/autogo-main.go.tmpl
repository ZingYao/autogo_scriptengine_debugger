	if err := os.WriteFile(filepath.Join(c.remoteRoot, "CURRENT"), []byte(request.ManifestID), 0600); err != nil { writeError(w, http.StatusInternalServerError, "COMMIT_FAILED", err); return }
	c.mu.Lock(); c.manifestID = request.ManifestID; c.recordLocked("manifest committed " + request.ManifestID); c.mu.Unlock()
