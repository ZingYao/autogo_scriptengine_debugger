	cursor := c.logBase
	if raw := r.URL.Query().Get("cursor"); raw != "" { if parsed, err := strconv.Atoi(raw); err == nil { cursor = parsed } }
	if cursor < c.logBase { cursor = c.logBase }
	end := c.logBase + len(c.logs)
	if cursor > end { cursor = end }
	writeJSON(w, http.StatusOK, map[string]any{"cursor": end, "entries": append([]string{}, c.logs[cursor-c.logBase:]...)})
}

var eventUpgrader = websocket.Upgrader{CheckOrigin: func(r *http.Request) bool { return r.Header.Get("Origin") == "" }}

// events 提供低延迟的状态、日志和会话停止控制；HTTP 接口继续作为断线降级通道。
func (c *controller) events(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet { methodNotAllowed(w); return }
	connection, err := eventUpgrader.Upgrade(w, r, nil)
	if err != nil { return }
	defer connection.Close()
	events := make(chan string, 64)
	c.mu.Lock(); c.subscribers[events] = struct{}{}; initial := c.stateEventLocked("connected"); c.mu.Unlock()
	defer func() { c.mu.Lock(); delete(c.subscribers, events); close(events); c.mu.Unlock() }()
	done := make(chan struct{})
	go func() {
		defer close(done)
		if writeErr := connection.WriteMessage(websocket.TextMessage, []byte(initial)); writeErr != nil { return }
		for event := range events { if writeErr := connection.WriteMessage(websocket.TextMessage, []byte(event)); writeErr != nil { return } }
	}()
	for {
		var command struct { Type string `json:"type"`; SessionID string `json:"sessionId"` }
		if readErr := connection.ReadJSON(&command); readErr != nil { return }
		switch command.Type {
		case "stop-debug":
			c.mu.Lock(); matches := command.SessionID == "" || command.SessionID == c.sessionID; c.mu.Unlock()
			if matches { c.closeEngine() }
		case "stop-engine":
			c.closeEngine()
		case "ping":
			c.mu.Lock(); event := c.stateEventLocked("pong"); c.mu.Unlock(); select { case events <- event: default: }
		}
		select { case <-done: return; default: }
	}
}

func (c *controller) authorize(next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		token := os.Getenv("AUTOGO_CONTROL_TOKEN")
		if token != "" && r.Header.Get("Authorization") != "Bearer "+token { writeError(w, http.StatusUnauthorized, "UNAUTHORIZED", errors.New("控制令牌无效")); return }
		next(w, r)
	}
}

func (c *controller) resolveEntryLocked(manifestID, entry string) (string, error) {
	if entry == "" { entry = "main.lua" }
	if manifestID == "" { manifestID = c.manifestID }
	root := "."
	if manifestID != "" { if err := validID(manifestID); err != nil { return "", err }; root = filepath.Join(c.remoteRoot, "releases", manifestID) }
	return safeJoin(root, entry)
}

func (c *controller) writeState(w http.ResponseWriter) { writeJSON(w, http.StatusOK, map[string]any{"service": "autogo-script-engine", "instanceId": c.instanceID, "protocolVersion": protocolVersion, "state": c.state, "sessionId": c.sessionID, "manifestId": c.manifestID, "lastError": c.lastError, "controlPort": c.controlPort, "dapPort": c.dapPort}) }
func (c *controller) failLocked(w http.ResponseWriter, code string, err error) { c.state, c.lastError = "failed", err.Error(); c.recordLocked(err.Error()); writeError(w, http.StatusInternalServerError, code, err) }
func (c *controller) record(message string) { c.mu.Lock(); defer c.mu.Unlock(); c.recordLocked(message) }
func (c *controller) recordLocked(message string) { entry := time.Now().Format(time.RFC3339)+" "+message; c.logs = append(c.logs, entry); if len(c.logs) > 512 { removed := len(c.logs)-512; c.logs = append([]string(nil), c.logs[removed:]...); c.logBase += removed }; c.broadcastLocked(map[string]any{"type": "log", "entry": entry}); log.Print(message) }
func (c *controller) stateEventLocked(eventType string) string { value, _ := json.Marshal(map[string]any{"type": eventType, "instanceId": c.instanceID, "state": c.state, "sessionId": c.sessionID, "lastError": c.lastError, "dapPort": c.dapPort}); return string(value) }
func (c *controller) broadcastLocked(value any) { content, err := json.Marshal(value); if err != nil { return }; for subscriber := range c.subscribers { select { case subscriber <- string(content): default: } } }

func validID(value string) error { if value == "" || strings.ContainsAny(value, "/\\") || value == "." || value == ".." { return errors.New("manifestId 无效") }; return nil }
func safeJoin(root, relative string) (string, error) { if relative == "" || filepath.IsAbs(relative) { return "", errors.New("路径必须是非空相对路径") }; clean := filepath.Clean(filepath.FromSlash(relative)); if clean == ".." || strings.HasPrefix(clean, ".."+string(filepath.Separator)) { return "", errors.New("路径不能逃逸项目目录") }; return filepath.Join(root, clean), nil }
func fileSHA256(path string) (string, error) { info, err := os.Lstat(path); if err != nil { return "", err }; if !info.Mode().IsRegular() { return "", errors.New("只允许普通文件") }; content, err := os.ReadFile(path); if err != nil { return "", err }; sum := sha256.Sum256(content); return hex.EncodeToString(sum[:]), nil }
func copyRegularFile(source, target string) error { content, err := os.ReadFile(source); if err != nil { return err }; if err = os.MkdirAll(filepath.Dir(target), 0700); err != nil { return err }; return os.WriteFile(target, content, 0600) }
func readCurrentManifest(root string) string { content, err := os.ReadFile(filepath.Join(root, "CURRENT")); if err != nil { return "" }; value := strings.TrimSpace(string(content)); if validID(value) != nil { return "" }; return value }
func moduleVersion(path string) string { info, ok := buildinfo.ReadBuildInfo(); if !ok { return "unknown" }; for _, dependency := range info.Deps { if dependency.Path == path { if dependency.Replace != nil && dependency.Replace.Version != "" { return dependency.Replace.Version }; if dependency.Version != "" { return dependency.Version } } }; return "unknown" }
func decodeJSON(r *http.Request, value any) error { defer r.Body.Close(); decoder := json.NewDecoder(r.Body); decoder.DisallowUnknownFields(); return decoder.Decode(value) }
func methodNotAllowed(w http.ResponseWriter) { writeError(w, http.StatusMethodNotAllowed, "METHOD_NOT_ALLOWED", errors.New("请求方法不受支持")) }
func writeJSON(w http.ResponseWriter, status int, value any) { w.Header().Set("Content-Type", "application/json"); w.WriteHeader(status); _ = json.NewEncoder(w).Encode(value) }
func writeError(w http.ResponseWriter, status int, code string, err error) { writeJSON(w, status, map[string]any{"error": map[string]any{"code": code, "message": err.Error(), "detail": err.Error(), "retryable": false}}) }
